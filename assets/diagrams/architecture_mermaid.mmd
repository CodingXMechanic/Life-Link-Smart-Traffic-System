graph TB
    subgraph Vehicles["Vehicle Layer (Saumya)"]
        V1["Vehicle car\nUUID position velocity"]
        V2["Vehicle ambulance\npriority_flag=1 ETA"]
        PHY["physics.py\nupdate_kinematics\nbraking_distance\ncalculate_eta"]
        V1 & V2 -->|to_packet + broadcast| PHY
    end

    subgraph Comm["Communication Layer (Saumya)"]
        BRK["Broker\npublish(packet dict)\nget_packets List[dict]\nthread-safe queue"]
    end

    subgraph Controller["Controller Layer (Pulkit)"]
        CTRL["IntersectionController\nstep(dt)\nget_signal_state()\nlog_state()"]
        FS["FailSafeMonitor\nvalidate_transition\ncheck_conflict"]
        CTRL <-->|legal transition check| FS
    end

    subgraph UI["UI Layer (Pulkit)"]
        PG["pygame_ui.py\n4-Zone Renderer\nVehicle Sprites\nHUD Panel"]
        HTML["HTML Dashboard\nlive_state.json"]
    end

    subgraph Logging["Logging and Analysis (Saumya)"]
        LOG["CSVLogger\nlog_vehicle\nlog_event\nlog_from_packet"]
        ANA["compare.py\nFixed vs Adaptive\nMatplotlib Charts"]
    end

    PHY -->|V2I packet JSON| BRK
    BRK -->|get_packets| CTRL
    CTRL -->|get_signal_state| PG
    CTRL -->|log_state| LOG
    PG -->|live JSON dump| HTML
    LOG --> ANA
